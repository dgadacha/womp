rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function goodName(n) { return n is string && n.size() >= 1 && n.size() <= 12; }
    function crewDoc(crewId) { return get(/databases/$(database)/documents/crews/$(crewId)).data; }
    function isMember(crewId) { return signedIn() && me() in crewDoc(crewId).members; }

    // Le jour choisi par le téléphone doit coller à l'heure du serveur,
    // tous fuseaux confondus (UTC-12 à UTC+14).
    function dayIsNow(day) {
      let p = day.split('-');
      let start = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time >= start - duration.value(14, 'h')
        && request.time < start + duration.value(36, 'h');
    }

    // Profil : chacun ne voit et n'écrit que le sien.
    match /users/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['crewId', 'name'])
        && request.resource.data.crewId is string
        && goodName(request.resource.data.name);
    }

    // Invitation : on la lit en connaissant son code, on ne peut pas les lister.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['crewId'])
        && getAfter(/databases/$(database)/documents/crews/$(request.resource.data.crewId)).data.createdBy == me()
        && getAfter(/databases/$(database)/documents/crews/$(request.resource.data.crewId)).data.code == code;
      allow update, delete: if false;
    }

    match /crews/{crewId} {
      allow get: if signedIn() && me() in resource.data.members;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'code', 'members', 'names', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.members == [me()]
        && request.resource.data.names.keys().hasOnly([me()])
        && goodName(request.resource.data.names[me()]);

      // Deux changements permis : entrer soi-même dans la bande, ou changer son propre prénom.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([me()])
        && goodName(request.resource.data.names[me()])
        && (
          (me() in resource.data.members && request.resource.data.members == resource.data.members)
          || (
            !(me() in resource.data.members)
            && resource.data.members.size() < 12
            && request.resource.data.members == resource.data.members.concat([me()])
          )
        );
      allow delete: if false;

      // Un score par joueur et par jour : l'identifiant du document est celui du joueur,
      // et on ne peut que le créer.
      match /days/{day}/scores/{uid} {
        allow read: if isMember(crewId);
        allow create: if isMember(crewId)
          && uid == me()
          && dayIsNow(day)
          && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
          && goodName(request.resource.data.name)
          && request.resource.data.score is int
          && request.resource.data.score >= -150 && request.resource.data.score <= 150
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Réactions : un document par joueur et par jour, qu'il réécrit à volonté.
      match /days/{day}/reactions/{uid} {
        allow read: if isMember(crewId);
        allow write: if isMember(crewId)
          && uid == me()
          && dayIsNow(day)
          && request.resource.data.keys().hasOnly(['picks'])
          && request.resource.data.picks is list
          && request.resource.data.picks.size() <= 40;
      }
    }
  }
}
