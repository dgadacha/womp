rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function goodName(n) { return n is string && n.size() >= 1 && n.size() <= 12; }
    function crewDoc(crewId) { return get(/databases/$(database)/documents/crews/$(crewId)).data; }
    function isMember(crewId) { return signedIn() && me() in crewDoc(crewId).members; }

    // Profil : chacun ne voit et n'écrit que le sien.
    match /users/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['crewId', 'name'])
        && request.resource.data.crewId is string
        && goodName(request.resource.data.name);
    }

    // Invitation : on la lit en connaissant son code, on ne peut pas les lister.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['crewId'])
        && getAfter(/databases/$(database)/documents/crews/$(request.resource.data.crewId)).data.createdBy == me()
        && getAfter(/databases/$(database)/documents/crews/$(request.resource.data.crewId)).data.code == code;
      allow update, delete: if false;
    }

    match /crews/{crewId} {
      allow get: if signedIn() && me() in resource.data.members;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'code', 'members', 'names', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.members == [me()]
        && request.resource.data.names.keys().hasOnly([me()])
        && goodName(request.resource.data.names[me()]);

      // Deux changements permis à tous : entrer soi-même dans la bande, ou changer son propre prénom.
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([me()])
          && goodName(request.resource.data.names[me()])
          && (
            (me() in resource.data.members && request.resource.data.members == resource.data.members)
            || (
              !(me() in resource.data.members)
              && resource.data.members.size() < 12
              && request.resource.data.members == resource.data.members.concat([me()])
            )
          )
        )
        // Le créateur choisit le type de gages, et rien d'autre.
        || (
          resource.data.createdBy == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dares'])
          && request.resource.data.dares in ['classic', 'party']
        )
        // Un membre quitte la bande : il ne retire que lui-même.
        || (
          me() in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet())
        )
      );
      allow delete: if false;

      // Mode instantané. Le numéro de manche ne fait que monter : une manche passée
      // n'accepte plus de score, et personne ne peut revenir en arrière.
      match /live/{liveDoc} {
        function shaped() {
          return request.resource.data.keys().hasOnly(['round', 'base', 'open', 'by', 'at'])
            && request.resource.data.round is int
            && request.resource.data.round >= 1 && request.resource.data.round <= 100000
            && request.resource.data.base is int
            && request.resource.data.open is bool
            && request.resource.data.by == me()
            && request.resource.data.at == request.time;
        }

        allow read: if liveDoc == 'state' && isMember(crewId);
        allow create: if liveDoc == 'state' && isMember(crewId) && shaped()
          && request.resource.data.round == 1
          && request.resource.data.base == 1
          && request.resource.data.open == true;
        allow update: if liveDoc == 'state' && isMember(crewId) && shaped() && (
          // jeu suivant de la session en cours
          (resource.data.open == true && request.resource.data.open == true
            && request.resource.data.round == resource.data.round + 1
            && request.resource.data.base == resource.data.base)
          // fin de la session
          || (resource.data.open == true && request.resource.data.open == false
            && request.resource.data.round == resource.data.round
            && request.resource.data.base == resource.data.base)
          // nouvelle session
          || (resource.data.open == false && request.resource.data.open == true
            && request.resource.data.round == resource.data.round + 1
            && request.resource.data.base == request.resource.data.round)
        );
        allow delete: if false;

        // Un score par joueur et par manche, seulement pour la manche en cours.
        match /rounds/{n}/scores/{uid} {
          allow read: if isMember(crewId);
          allow create: if isMember(crewId)
            && uid == me()
            && get(/databases/$(database)/documents/crews/$(crewId)/live/state).data.open == true
            && string(get(/databases/$(database)/documents/crews/$(crewId)/live/state).data.round) == n
            && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
            && goodName(request.resource.data.name)
            && request.resource.data.score is int
            && request.resource.data.score >= -150 && request.resource.data.score <= 150
            && request.resource.data.at == request.time;
          allow update, delete: if false;
        }
      }
    }
  }
}
